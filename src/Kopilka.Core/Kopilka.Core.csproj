<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Переносимое ядро: без -windows, без WPF и WinAPI.
         Требование шага 0 — Core собирается как обычная библиотека net10.0;
         это проверяется юнит-тестом ArchitectureTests. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Доступ к SQLite через Entity Framework Core — требование задания.
         Microsoft.Data.Sqlite приходит транзитивно из этого пакета.
         Design нужен только для генерации миграций (dotnet ef) и
         в рантайме приложения не используется. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" PrivateAssets="all" />
  </ItemGroup>

</Project>
