<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Переносимое ядро: без -windows, без WPF и WinAPI.
         Требование шага 0 — Core собирается как обычная библиотека net10.0;
         это проверяется юнит-тестом ArchitectureTests. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
