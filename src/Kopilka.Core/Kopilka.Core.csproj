<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Переносимое ядро: без -windows, без WPF и WinAPI.
         Требование шага 0 — Core собирается как обычная библиотека net10.0;
         это проверяется юнит-тестом ArchitectureTests. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Единственная зависимость ядра: доступ к SQLite без Entity Framework.
         DI и логирование живут в Kopilka.App, на уровне композиции. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Миграции встраиваются в сборку: работают после публикации
         на чистой машине, не зависят от внешних файлов. -->
    <EmbeddedResource Include="Data\Migrations\*.sql" />
  </ItemGroup>

</Project>
