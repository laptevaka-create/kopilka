<Window x:Class="Kopilka.App.RecurringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регулярные платежи"
        Width="700" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Список шаблонов -->
        <ListBox ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem}"
                 DisplayMemberPath="Display"
                 FontSize="13"
                 Grid.Row="0" Grid.Column="0" Margin="0,0,16,0" />

        <!-- Панель шаблона -->
        <StackPanel Grid.Row="0" Grid.Column="1" Width="250">
            <TextBlock Text="Шаблон" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="Категория" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding CategoryOptions}"
                      SelectedItem="{Binding SelectedCategory}"
                      DisplayMemberPath="Display"
                      Margin="0,0,0,10" />
            <TextBlock Text="Счёт" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding AccountOptions}"
                      SelectedItem="{Binding SelectedAccount}"
                      DisplayMemberPath="Name"
                      Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="120">
                    <TextBlock Text="Сумма, ₽" Margin="0,0,0,4" />
                    <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" />
                </StackPanel>
                <StackPanel Width="90" Margin="10,0,0,0">
                    <TextBlock Text="День (1–31)" Margin="0,0,0,4" />
                    <TextBox Text="{Binding DayText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Комментарий" Margin="0,0,0,4" />
            <TextBox Text="{Binding CommentText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10" />
            <CheckBox Content="Шаблон активен"
                      IsChecked="{Binding IsActive}"
                      Margin="0,0,0,14" />
            <Button Content="Добавить"
                    Command="{Binding AddTemplateCommand}"
                    Padding="10,4" Margin="0,0,0,8" />
            <Button Content="Сохранить"
                    Command="{Binding SaveChangesCommand}"
                    Padding="10,4" Margin="0,0,0,8" />
            <Button Content="Удалить"
                    Command="{Binding DeleteTemplateCommand}"
                    Padding="10,4" />
            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="Gray"
                       Text="По активным шаблонам транзакции создаются при запуске программы и при открытии месяца. 31-е число в коротком месяце начисляется в последний день." />
        </StackPanel>

        <!-- Ошибки -->
        <TextBlock Text="{Binding ValidationSummary}"
                   Foreground="#B00020"
                   TextWrapping="Wrap"
                   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="0,10,0,0" />
    </Grid>
</Window>
