<Window x:Class="Kopilka.App.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding MonthTitle, StringFormat='Отчёт — {0}'}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Доходы" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
        <ItemsControl ItemsSource="{Binding IncomeRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CategoryName}" />
                        <TextBlock Grid.Column="1" Text="{Binding SumText}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="{Binding ShareText}"
                                   HorizontalAlignment="Right" Foreground="#1E7B34" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding IncomeTotalText, StringFormat='Итого доходы: {0}'}"
                   FontWeight="SemiBold" Margin="0,8,0,16"
                   HorizontalAlignment="Right" Foreground="#1E7B34" />

        <TextBlock Text="Расходы" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
        <ItemsControl ItemsSource="{Binding ExpenseRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CategoryName}" />
                        <TextBlock Grid.Column="1" Text="{Binding SumText}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="{Binding ShareText}"
                                   HorizontalAlignment="Right" Foreground="#B00020" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding ExpenseTotalText, StringFormat='Итого расходы: {0}'}"
                   FontWeight="SemiBold" Margin="0,8,0,16"
                   HorizontalAlignment="Right" Foreground="#B00020" />

        <TextBlock Text="{Binding BalanceText, StringFormat='Сальдо: {0}'}"
                   FontWeight="SemiBold" Margin="0,0,0,16"
                   HorizontalAlignment="Right" />

        <Button Content="Закрыть" IsCancel="True"
                MinWidth="90" Padding="10,4" HorizontalAlignment="Right" />
    </StackPanel>
</Window>
