<Window x:Class="Kopilka.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Копилка — учёт личных финансов"
        Width="960" Height="660"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Шапка: выбор месяца и действия -->
        <Border DockPanel.Dock="Top" Background="#F5F5F5" Padding="10,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Категории"
                            Command="{Binding ShowCategoriesCommand}"
                            MinWidth="100" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Изменить"
                            Command="{Binding EditTransactionCommand}"
                            MinWidth="100" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Удалить"
                            Command="{Binding DeleteTransactionCommand}"
                            MinWidth="100" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Добавить"
                            Command="{Binding AddTransactionCommand}"
                            MinWidth="110" Padding="14,4" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="‹" Command="{Binding PreviousMonthCommand}"
                            Width="34" FontSize="16" Padding="0,2" />
                    <TextBlock Text="{Binding MonthTitle}"
                               FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="14,0" MinWidth="150"
                               TextAlignment="Center" />
                    <Button Content="›" Command="{Binding NextMonthCommand}"
                            Width="34" FontSize="16" Padding="0,2" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Фильтры: категория и произвольный период -->
        <Border DockPanel.Dock="Top" Background="#FBFBFB"
                BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="10,5">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding FilterCategories}"
                              SelectedItem="{Binding SelectedFilterCategory}"
                              DisplayMemberPath="Display"
                              MinWidth="210" Margin="0,0,16,0" />
                    <TextBlock Text="с" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding FilterFromText, UpdateSourceTrigger=PropertyChanged}"
                             Width="90" Margin="0,0,8,0" />
                    <TextBlock Text="по" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding FilterToText, UpdateSourceTrigger=PropertyChanged}"
                             Width="90" Margin="0,0,10,0" />
                    <Button Content="Показать" Command="{Binding ApplyPeriodCommand}"
                            Padding="12,3" Margin="0,0,6,0" />
                    <Button Content="Сбросить" Command="{Binding ResetPeriodCommand}"
                            Padding="12,3" />
                </StackPanel>
                <TextBlock Text="{Binding FilterError}"
                           Foreground="#B00020" FontSize="12"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Итоги периода -->
        <Border DockPanel.Dock="Bottom" Background="#FAFAFA"
                Padding="10,6" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Доходы:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding IncomeText}" VerticalAlignment="Center"
                           Foreground="#1E7B34" FontWeight="SemiBold" Margin="0,0,18,0" />
                <TextBlock Text="Расходы:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding ExpenseText}" VerticalAlignment="Center"
                           Foreground="#B00020" FontWeight="SemiBold" Margin="0,0,18,0" />
                <TextBlock Text="Сальдо:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding BalanceText}" VerticalAlignment="Center"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- Статус хранилища -->
        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,3">
            <TextBlock x:Name="DatabaseStatusText" FontSize="12" Foreground="Gray" />
        </Border>

        <!-- Журнал -->
        <DataGrid ItemsSource="{Binding Transactions}"
                  SelectedItem="{Binding SelectedTransaction}"
                  MouseDoubleClick="OnTransactionDoubleClick"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding DisplayDate}" Width="110" />
                <DataGridTextColumn Header="Счёт" Binding="{Binding AccountName}" Width="130" />
                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="170" />
                <DataGridTextColumn Header="Комментарий" Binding="{Binding DisplayComment}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Сумма" Binding="{Binding DisplayAmount}" Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Income">
                                    <Setter Property="Foreground" Value="#1E7B34" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Expense">
                                    <Setter Property="Foreground" Value="#B00020" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
